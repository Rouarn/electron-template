# ============================================================
# Electron Template 主进程 / 工具链环境变量示例
#
# 注意：Electron 主进程不读取 .env 文件，本文件只作为变量清单参考。
# 需要生效时，在启动 / 安装 / 打包前通过 shell 导出（export KEY=value），或由 CI 注入。
# 渲染进程变量（VITE_ 前缀）见 frontend/.env.example。
# 每条都标注了：用途 / 是否必填 / 默认值 / 格式示例 / 取值来源。
# ============================================================

# ---------- 主进程：日志与调试 ----------

# ELECTRON_LOG_LEVEL：主进程写盘日志的最低级别。【可选】默认 info
# 示例：debug | info | warn | error（其它值会被忽略并回退到默认）
# 取值：排查问题时以 debug 启动，日常保持 info
# ELECTRON_LOG_LEVEL=info

# ELECTRON_ENABLE_DEVTOOLS：打包后是否允许打开开发者工具。【可选】默认不设置（生产环境强制关闭）
# 示例：1
# 取值：仅调试已打包版本时临时设为 1，正式发布不要设置
# ELECTRON_ENABLE_DEVTOOLS=1

# ---------- 主进程：自动更新（仅打包后生效） ----------

# APP_UPDATE_FEED_URL：覆盖 electron-builder.config.cjs 中 publish.url 的更新源。【可选】默认使用 publish.url
# 示例：https://updates.example.com/electron-template/
# 取值：自建 HTTPS 静态目录（需放 latest.yml 等清单）；非 HTTPS 会被主进程直接拒绝
# APP_UPDATE_FEED_URL=https://updates.example.com/electron-template/

# ALLOW_INSECURE_UPDATE：是否允许明文 HTTP 更新源。【可选】默认不设置（只允许 HTTPS）
# 示例：1
# 取值：仅本机联调更新流程时设为 1，正式环境严禁开启
# ALLOW_INSECURE_UPDATE=1

# ---------- 开发脚本 ----------

# DEV_PORT：pnpm dev 时渲染进程（Vite）使用的端口。【可选】默认从 5173 起自动探测第一个空闲端口
# 示例：5173
# 取值：默认端口段被占用时显式指定；指定的端口被占用会直接报错，不会自动换端口
# DEV_PORT=5173

# DEV_SERVER_URL：主进程判定「开发模式」并加载的渲染进程地址。【内部变量】不要手动设置
# 示例：http://127.0.0.1:5173
# 取值：由 scripts/dev.mjs 启动时注入；手动设置会让打包后的应用误判为开发模式
# DEV_SERVER_URL=

# ---------- 安装与打包镜像 ----------

# ELECTRON_MIRROR：下载 Electron 二进制使用的镜像根地址。【可选】默认取 .npmrc 的 electron_mirror，仍为空则用 npmmirror
# 示例：https://npmmirror.com/mirrors/electron/
# 取值：国内网络或私有源；必须带结尾斜杠，否则拼接出的下载地址会出错
# ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/

# ELECTRON_BUILDER_BINARIES_MIRROR：electron-builder 工具二进制（nsis / fpm / 7zip 等）镜像根地址。【可选】默认取 .npmrc 的 electron-builder-binaries_mirror，仍为空则用 npmmirror
# 示例：https://npmmirror.com/mirrors/electron-builder-binaries/
# 取值：国内网络或私有源；打包配置在 ELECTRON_MIRROR 缺失时会拿它兜底，所以不要填成 Electron 的镜像目录
# ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/
